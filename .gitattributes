# Normalize line endings: LF in the repo, native in the working tree.
* text=auto

# Keep these LF even on Windows checkouts.
*.sh text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.spv binary
*.ttf binary
*.tindex binary
*.tpack binary

# LFS for the TerrainCheck Icelandic sand source textures.
games/TerrainCheck/assets/textures/icelandic_sand_and_rocks/*.jpg filter=lfs diff=lfs merge=lfs -text

# LFS for the Caldera demo's large files. .lfsconfig leaves them out of a default fetch.
games/CalderaDemo/assets/models/**/*.glb filter=lfs diff=lfs merge=lfs -text
games/CalderaDemo/assets/meshes/ocean.mesh.json filter=lfs diff=lfs merge=lfs -text
games/CalderaDemo/assets/textures/icelandic_sand_and_rocks/*.jpg filter=lfs diff=lfs merge=lfs -text
games/CalderaDemo/source/caldera.heights filter=lfs diff=lfs merge=lfs -text
