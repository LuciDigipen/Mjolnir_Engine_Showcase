if(NOT DEFINED SOURCE_DIR OR NOT DEFINED BINARY_DIR OR NOT DEFINED SLANGC_EXECUTABLE)
    message(FATAL_ERROR "SurfaceMaterialFixture.cmake needs SOURCE_DIR, BINARY_DIR and SLANGC_EXECUTABLE")
endif()

file(REMOVE_RECURSE "${BINARY_DIR}")
file(MAKE_DIRECTORY "${BINARY_DIR}")
file(COPY "${SOURCE_DIR}/assets" DESTINATION "${BINARY_DIR}")
set(assets "${BINARY_DIR}/assets")
file(WRITE "${assets}/nested/extra.slang" "// Include added after the first build.\n")

set(toolchain_args "")
if(DEFINED CMAKE_MAKE_PROGRAM AND CMAKE_MAKE_PROGRAM)
    list(APPEND toolchain_args -DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM})
endif()
if(DEFINED CMAKE_CXX_COMPILER AND CMAKE_CXX_COMPILER)
    list(APPEND toolchain_args -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER})
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${BINARY_DIR}" -G Ninja
            -DCMAKE_BUILD_TYPE=Debug
            -DSLANGC_EXECUTABLE=${SLANGC_EXECUTABLE}
            -DFIXTURE_ASSETS=${assets}
            ${toolchain_args}
    RESULT_VARIABLE configure_result)
if(NOT configure_result EQUAL 0)
    message(FATAL_ERROR "fixture configure failed: ${configure_result}")
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env CMAKE_BUILD_PARALLEL_LEVEL=1 "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --target surface_fixture_surface_shaders_fixture --parallel 1
    RESULT_VARIABLE build_result)
if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "fixture shader build failed: ${build_result}")
endif()

file(READ "${BINARY_DIR}/shaders/surface_materials.json" catalog)
string(JSON material_count ERROR_VARIABLE catalog_error LENGTH "${catalog}" materials)
if(catalog_error OR NOT material_count EQUAL 5)
    message(FATAL_ERROR "fixture catalog expected 5 mesh entries, got '${material_count}' (${catalog_error})")
endif()

set(stem_a "")
set(stem_b "")
set(stem_dash "")
set(stem_under "")
set(stem_deferred "")
foreach(index RANGE 0 4)
    string(JSON stem GET "${catalog}" materials ${index} stem)
    string(JSON asset GET "${catalog}" materials ${index} asset)
    if(asset MATCHES "00_terrain")
        message(FATAL_ERROR "terrain-only fixture leaked into the mesh catalog")
    elseif(asset MATCHES "/a\\.material\\.json$")
        set(stem_a "${stem}")
    elseif(asset MATCHES "/b\\.material\\.json$")
        set(stem_b "${stem}")
    elseif(asset MATCHES "/a-b\\.material\\.json$")
        set(stem_dash "${stem}")
    elseif(asset MATCHES "/a_b\\.material\\.json$")
        set(stem_under "${stem}")
    elseif(asset MATCHES "/zz_mesh\\.material\\.json$")
        set(stem_deferred "${stem}")
    endif()
endforeach()
if(NOT stem_a OR NOT stem_b OR NOT stem_dash OR NOT stem_under OR NOT stem_deferred)
    message(FATAL_ERROR "fixture catalog is missing an expected asset")
endif()
if(NOT stem_a STREQUAL stem_b)
    message(FATAL_ERROR "two assets reusing one shader did not share a stem")
endif()
if(stem_dash STREQUAL stem_under)
    message(FATAL_ERROR "punctuation-distinct types aliased")
endif()
if(NOT stem_deferred MATCHES "DeferredFixtureMaterial")
    message(FATAL_ERROR "terrain-first deferred material did not compile for mesh")
endif()

file(GLOB shared_outputs "${BINARY_DIR}/shaders/${stem_a}.fragmentMain.spv")
if(NOT shared_outputs)
    message(FATAL_ERROR "shared shader output missing")
endif()
list(GET shared_outputs 0 shared_output)
file(TIMESTAMP "${shared_output}" first_time "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)

file(APPEND "${assets}/nested/shared.slang" "\n#include \"extra.slang\"\n")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env CMAKE_BUILD_PARALLEL_LEVEL=1 "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --target surface_fixture_surface_shaders_fixture --parallel 1
    RESULT_VARIABLE include_build)
if(NOT include_build EQUAL 0)
    message(FATAL_ERROR "build after newly referenced include failed")
endif()
file(TIMESTAMP "${shared_output}" second_time "%s")
if(NOT second_time GREATER first_time)
    message(FATAL_ERROR "adding a referenced include did not rebuild the shader")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)

file(APPEND "${assets}/nested/extra.slang" "// Deep dependency edit.\n")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env CMAKE_BUILD_PARALLEL_LEVEL=1 "${CMAKE_COMMAND}" --build "${BINARY_DIR}" --target surface_fixture_surface_shaders_fixture --parallel 1
    RESULT_VARIABLE depfile_build)
if(NOT depfile_build EQUAL 0)
    message(FATAL_ERROR "build after editing a depfile-only include failed")
endif()
file(TIMESTAMP "${shared_output}" third_time "%s")
if(NOT third_time GREATER second_time)
    message(FATAL_ERROR "editing a depfile-only include did not rebuild the shader")
endif()

message(STATUS "Surface material fixture passed")
