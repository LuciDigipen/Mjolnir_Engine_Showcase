{
  "build": {
    "profile": "development"
  },
  "input": {
    "actions": [
      {
        "name": "SceneDemoNext",
        "type": "Button",
        "bindings": [ { "device": "Keyboard", "key": "N" } ]
      },
      {
        "name": "SceneDemoAdditive",
        "type": "Button",
        "bindings": [ { "device": "Keyboard", "key": "B" } ]
      }
    ]
  },
  "ide": {
    "args": "--new-window {project} {file}",
    "path": "C:\\Users\\rahul\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"
  },
  "physicsLayers": {
    "ignore": [
      [
        "Default",
        "Ghost"
      ]
    ],
    "names": [
      "Default",
      "Ghost"
    ]
  },
  "postProcessing": {
    "effects": {
      "Anti-Aliasing": {
        "enabled": true,
        "params": {
          "mode": "dlss",
          "rtSampleCount": 4
        }
      },
      "Bloom": {
        "enabled": true,
        "params": {
          "intensity": 0.5,
          "radius": 0.5,
          "threshold": 1.0
        }
      },
      "DepthOfField": {
        "enabled": false,
        "params": {}
      },
      "Film": {
        "enabled": false,
        "params": {}
      },
      "Fog": {
        "enabled": true,
        "params": {}
      },
      "HDR": {
        "enabled": false,
        "params": {
          "tonemapOperator": "aces"
        }
      },
      "MotionBlur": {
        "enabled": false,
        "params": {}
      }
    }
  },
  "rendering": {
    "ddgi": {
      "enabled": true,
      "intensity": 1.0,
      "origin": [
        0.0,
        0.0,
        0.0
      ],
      "probeCounts": [
        8,
        8,
        8
      ],
      "probeSpacing": 2.0,
      "probesPerFrame": 512,
      "raysPerProbe": 128
    },
    "rayTracing": true
  }
}
